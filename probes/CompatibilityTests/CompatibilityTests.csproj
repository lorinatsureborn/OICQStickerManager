<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>..\..\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OICQStickerManager.csproj" />
    <!-- App views use application-root pack URIs, which resolve against this test host. -->
    <Resource Include="..\..\Assets\Asuka.ico" Link="Assets\Asuka.ico" />
    <Resource Include="..\..\Assets\bird-mask.png" Link="Assets\bird-mask.png" />
  </ItemGroup>
</Project>
