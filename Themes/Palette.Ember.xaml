<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 暮色：暖深玻璃 · 落日橙。微暖的深色雾面配 systemOrange（dark），亮橙上用近黑文字保证可读 -->

    <Color x:Key="AccentColor">#FF9F0A</Color>
    <Color x:Key="TextPrimaryColor">#F5F5F7</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFB23E"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#E58900"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1C1C1E"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6AD"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E6E76"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF453A"/>

    <!-- 材质 -->
    <SolidColorBrush x:Key="GlassOverlayBrush" Color="#B3241F1B"/>
    <SolidColorBrush x:Key="SheetBrush" Color="#F2241F1B"/>
    <SolidColorBrush x:Key="MaterialBrush" Color="#E82C2622"/>
    <SolidColorBrush x:Key="MaterialBorderBrush" Color="#29FFFFFF"/>

    <!-- 填充层级（iOS systemFill 家族，深色变体） -->
    <SolidColorBrush x:Key="FieldBrush" Color="#24787880"/>
    <SolidColorBrush x:Key="FieldHoverBrush" Color="#33787880"/>
    <SolidColorBrush x:Key="FillHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="FillPressedBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#33FF9F0A"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#73000000"/>

    <!-- 控件专用 -->
    <SolidColorBrush x:Key="ThumbBrush" Color="#FF6A6258"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#42FFFFFF"/>
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#30D158"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#3D3A36"/>

</ResourceDictionary>
