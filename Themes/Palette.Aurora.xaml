<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 晨雾：浅色玻璃 · iOS 蓝。白色雾面之上是 Apple 近黑文字与 systemBlue 强调 -->

    <Color x:Key="AccentColor">#007AFF</Color>
    <Color x:Key="TextPrimaryColor">#1D1D1F</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2E90FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0066D6"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#A1A1A6"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30"/>

    <!-- 材质 -->
    <SolidColorBrush x:Key="GlassOverlayBrush" Color="#B3F7F9FC"/>
    <SolidColorBrush x:Key="SheetBrush" Color="#F7FFFFFF"/>
    <SolidColorBrush x:Key="MaterialBrush" Color="#EDFCFCFD"/>
    <SolidColorBrush x:Key="MaterialBorderBrush" Color="#1F3C3C43"/>

    <!-- 填充层级（iOS systemFill 家族） -->
    <SolidColorBrush x:Key="FieldBrush" Color="#1F767680"/>
    <SolidColorBrush x:Key="FieldHoverBrush" Color="#2E767680"/>
    <SolidColorBrush x:Key="FillHoverBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="FillPressedBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F007AFF"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#163C3C43"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#59000000"/>

    <!-- 控件专用 -->
    <SolidColorBrush x:Key="ThumbBrush" Color="#FDFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#34C759"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#29787880"/>

</ResourceDictionary>
