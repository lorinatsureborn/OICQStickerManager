<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 WinForms 的 NotifyIcon（随运行时自带，任务栏重启等 shell 边界它都处理了） -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Asuka</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Asuka.ico</ApplicationIcon>
    <!-- 程序集版本 = 反馈表单「飞鸟版本」的来源（FeedbackService.AppVersion 读程序集版本）。
         此前从未设置 → 恒为默认 1.0.0.0，用户反馈里的版本标记全部误报 v1.0.0（Issue #2 实锤）。
         发版时必须与 GitHub tag 同步更新。 -->
    <Version>1.3.3</Version>
    <!-- WFO0003 是 WinForms 的提示（建议改用 ApplicationHighDpiMode 属性），WPF 不经过那条路径。
         DPI 感知必须留在 app.manifest（进程创建期生效，WinForms/WPF/UIA 全局一致），
         压掉警告防止后人按提示删 manifest 设置，重新引入 Win11 缩放下点击跑偏的 bug。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Asuka.ico" />
    <Resource Include="Assets\bird-mask.png" />
    <!-- 内嵌字体（Inter=拉丁/数字 OFL，MiSans=中文 小米免费商用）：pack URI 按家族名引用 -->
    <None Remove="Fonts\*.otf" />
    <None Remove="Fonts\*.ttf" />
    <Resource Include="Fonts\*.otf" />
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fonts\LICENSE-Inter-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fonts\README-MiSans.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms 全局 using 与 WPF 类型名冲突（Size/KeyEventArgs/Image…），
         移除后托盘代码里的全限定 System.Windows.Forms.NotifyIcon 不受影响 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- probes/ 是独立小工具（各自有 csproj），主工程在仓库根目录会默认通配到它们，
         显式剔除，防止探针的 App/MainWindow 混进主工程编译 -->
    <Compile Remove="probes\**" />
    <Page Remove="probes\**" />
    <ApplicationDefinition Remove="probes\**" />
    <Content Remove="probes\**" />
    <None Remove="probes\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

</Project>
